# Copy to .env (git-ignored) and load it with: set -a; source .env; set +a
AWS_REGION=us-west-2

# Database: host + the RDS-managed secret (stack output DBSecretArn). The cluster is private,
# so from a laptop run the stack's PortForwardCommand and use localhost.
TRIAGE_DB_HOST=localhost
TRIAGE_DB_NAME=triage
TRIAGE_DB_SECRET_ARN=
# Or a full libpq URL instead:
# TRIAGE_DATABASE_URL=postgresql://user:password@localhost:5432/triage?sslmode=require

TRIAGE_TENANT_ID=demo
TRIAGE_MODEL=anthropic.claude-opus-5-5
TRIAGE_FALLBACK_MODEL=anthropic.claude-opus-4-8
TRIAGE_EFFORT=medium
TRIAGE_WORKERS=4
# comprehend-medical (default) or regex (synthetic data only)
TRIAGE_REDACTOR=comprehend-medical

TRIAGE_AUDIT_DIR=./audit
TRIAGE_AUDIT_BUCKET=
